# ==============================================================================
# Pataghor (পাতাঘর) - Environment Variables Configuration
# ZERO-COST Architecture (All services run on free tier)
# ==============================================================================

# 1. Supabase (Free Tier: https://supabase.com)
# Obtain these from: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Resend Email (Free Tier: 100 emails/day, https://resend.com)
# Obtain from: API Keys > Create API Key
RESEND_API_KEY=re_123456789...
EMAIL_FROM=orders@pataghor.com

# 3. Public Website URL
NEXT_PUBLIC_SITE_URL=https://pataghor.com

# 4. Optional Mobile Financial Services (bKash / Nagad / SSLCommerz)
# Leave blank for Cash on Delivery first (active default)
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
NAGAD_MERCHANT_ID=
NAGAD_PUBLIC_KEY=
STORE_ID=
STORE_PASSWORD=

